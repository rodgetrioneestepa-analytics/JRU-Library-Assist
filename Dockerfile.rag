FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 HF_HUB_DISABLE_PROGRESS_BARS=1 HF_HUB_DISABLE_SYMLINKS_WARNING=1 ANONYMIZED_TELEMETRY=False
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY rag_backend/requirements.txt /app/rag_backend/requirements.txt
RUN pip install --no-cache-dir "torch>=2.6,<3" --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r rag_backend/requirements.txt waitress
ENV RAG_MODEL_PATH=/opt/library-assist/model RAG_CACHE_ROOT=/tmp/library-assist-chroma
COPY scripts/build-model.py /app/scripts/build-model.py
RUN python /app/scripts/build-model.py
COPY rag_backend /app/rag_backend
COPY server_data /app/server_data
COPY public /app/public
EXPOSE 80
CMD ["python", "-m", "rag_backend.serve"]
