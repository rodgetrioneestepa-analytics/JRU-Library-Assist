# Optional: conversational Groq generation and follow-up rewriting.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional Node/Vercel connection to a separately running Python backend.
# RAG_BACKEND_URL=http://127.0.0.1:5000
# Use an HTTPS origin for a deployed backend.
# RAG_BACKEND_TOKEN=
# RAG_WORKBOOK=C:/path/to/CONSOLIDATED FAQs for VLA.xlsx
RAG_DEVICE=cpu
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.35
PORT=3000
