# Optional: enables quote-validated generated answers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Python semantic backend: python -m rag_backend serves the complete app on :5000.
# To proxy it through Node locally, uncomment:
# RAG_BACKEND_URL=http://127.0.0.1:5000
# On Vercel, this must be a separately hosted HTTPS backend, not localhost.
# RAG_BACKEND_TOKEN=server-to-server-token
# RAG_GENERATOR=excerpts
# Use groq (requires GROQ_API_KEY) or flan-t5 for optional generation.
RAG_DEVICE=cpu
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=3
RAG_CANDIDATE_K=6
PORT=3000
