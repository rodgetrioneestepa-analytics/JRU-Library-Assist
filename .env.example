# Required: generation and follow-up rewriting; never publish the actual key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Required on hosted deployments using the prepared source. Copy the ignored
# server_data/private-overrides.json into a Vercel Production Secret, never Git.
RAG_PRIVATE_RECORD_OVERRIDES=
# Optional Node development proxy to the Python backend. Production uses Python.
# RAG_BACKEND_URL=http://127.0.0.1:5000
# Use an HTTPS origin for a deployed backend.
# RAG_BACKEND_TOKEN=
# RAG_WORKBOOK=C:/path/to/CONSOLIDATED FAQs for VLA.xlsx
RAG_DEVICE=cpu
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.35
# Local Python uses RAG_PORT=5000. The container honors Vercel's PORT (default 80).
